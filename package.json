{
  "name": "ankore",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Lean identity continuity module for Sil products: anchor + encore.",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm run test && npm run pack:check && npm run docs:check && npm run examples:check && npm run site:build",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "docs:check": "node scripts/check-product.mjs",
    "examples:check": "node scripts/check-example.mjs",
    "site:build": "vite build --config site/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8",
    "@vitejs/plugin-vue": "^6.0.2",
    "@sil/ui": "^2.3.5",
    "bemm": "^1.1.4",
    "open-icon": "^1.1.0",
    "sass": "^1.94.2",
    "vite": "^7.2.6",
    "vue": "^3.5.25",
    "vue-tsc": "^3.1.5"
  },
  "peerDependencies": {
    "vitest": ">=3 <5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "docs"
  ]
}
